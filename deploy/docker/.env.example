# CRMPro AI - Local Developer Environment Environment Variables
# Copy to .env in the same directory or project root

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=crmpro_dev
POSTGRES_USER=crmpro_app
POSTGRES_PASSWORD=crmpro_dev_password_2026

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=crmpro_redis_dev_2026

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=crmpro_user
RABBITMQ_DEFAULT_PASS=crmpro_rabbit_dev_2026
